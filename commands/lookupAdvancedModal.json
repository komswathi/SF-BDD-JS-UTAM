{
  "root": true,
  "selector": { "css": "body lightning-overlay-container" },
  "shadow": { "elements": [
    { "name": "baseModal", "public": false, "selector": { "css": "lightning-modal-base" },
      "shadow": { "elements": [
        { "name": "modal", "public": false,
          "selector": { "css": "lightning-modal:has(.lightning-record-picker-advanced-modal__body)" },
          "shadow": { "elements": [
            {
              "name": "resultsDatatable",
              "public": false,
              "type": "utam-lightning/pageObjects/datatable",
              "selector": { "css": "lightning-record-picker-advanced-results lightning-datatable" }
            },
            {
              "name": "searchInput",
              "public": false,
              "type": "utam-lightning/pageObjects/input",
              "selector": { "css": "lightning-record-picker-advanced-input lightning-input" }
            },
            { "name": "selectButton", "type": "utam-lightning/pageObjects/button", "public": false,
              "selector": { "css": "lightning-button[data-label='Select']" } },
            { "name": "cancelButton", "type": "utam-lightning/pageObjects/button", "public": false,
              "selector": { "css": "lightning-button[data-label='Cancel']" } }
          ]}
        }
      ]}
    }
  ]},
  "methods": [
    { "name": "close", "compose": [{ "element": "cancelButton", "apply": "click" }] },
    { "name": "confirm", "compose": [{ "element": "selectButton", "apply": "click" }] },
    { "name": "type", "compose": [{ "element": "searchInput", "apply": "setText",
      "args": [{ "name": "text", "type": "string" }] }] },
    { "name": "selectRecord", "compose": [{ "element": "resultsDatatable", "apply": "toggleRowSelection",
      "args": [{ "name": "rowIndex", "type": "number" }] }] },
    { "name": "isRecordSelected", "compose": [{ "element": "resultsDatatable", "apply": "isRowSelected",
      "args": [{ "name": "rowIndex", "type": "number" }] }] },
    { "name": "waitForRecords", "compose": [{ "apply": "waitFor", "args": [{ "type": "function", "predicate": [
      { "element": "resultsDatatable", "apply": "hasRows" }
    ]}]}] }
  ]
}